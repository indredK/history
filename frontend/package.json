{
  "name": "history-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/dist/node/cli.js",
    "start": "bun scripts/start.mjs",
    "build": "bun run type-check && node node_modules/vite/dist/node/cli.js build",
    "build:analyze": "node node_modules/vite/dist/node/cli.js build --mode analyze",
    "preview": "node node_modules/vite/dist/node/cli.js preview",
    "deploy": "bun scripts/deploy.mjs",
    "lint": "bunx eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 100",
    "lint:fix": "bunx eslint src --ext ts,tsx --fix",
    "type-check": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "vitest": "vitest"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/react": "^9.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "^9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/d3": "^7.4.3",
    "ahooks": "^3.11.0",
    "animate.css": "^4.1.1",
    "animejs": "^4.5.0",
    "axios": "^1.21.0",
    "d3": "^7.9.0",
    "deck.gl": "^9.4.1",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.5",
    "swiper": "^14.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "@tanstack/react-virtual": "^3.14.24",
    "@tanstack/virtual-core": "^3.19.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "sass": "^1.107.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.0"
  }
}
