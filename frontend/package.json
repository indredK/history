{
  "name": "history-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/dist/node/cli.js",
    "start": "bun scripts/start.mjs",
    "build": "bun run type-check && node node_modules/vite/dist/node/cli.js build",
    "build:analyze": "node node_modules/vite/dist/node/cli.js build --mode analyze",
    "preview": "node node_modules/vite/dist/node/cli.js preview",
    "deploy": "bun scripts/deploy.mjs",
    "lint": "bunx eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 100",
    "lint:fix": "bunx eslint src --ext ts,tsx --fix",
    "type-check": "bunx tsc --noEmit",
    "test": "bunx vitest --run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "vitest": "vitest"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/react": "^9.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/d3": "^7.4.3",
    "ahooks": "^3.9.7",
    "animate.css": "^4.1.1",
    "animejs": "^4.4.1",
    "axios": "^1.16.1",
    "d3": "^7.9.0",
    "deck.gl": "^9.3.2",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.15.1",
    "swiper": "^14.0.6",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@tanstack/virtual-core": "^3.16.00",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-remove-properties": "^0.3.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "sass": "^1.100.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.0"
  }
}
