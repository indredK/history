  {
    "id": "cc24a7ae-620a-448d-b399-05b07307b817",
    "name": "盘古开天",
    "category": "创世神话",
    "origin": "《三五历纪》《述异记》",
    "period": null,
    "description": "混沌初开，天地未分，盘古在其中孕育了一万八千年。醒来后，他挥动巨斧劈开混沌，清气上升为天，浊气下沉为地。盘古顶天立地，每日长高一丈，天地也随之增厚。又过一万八千年，盘古力竭而亡，他的身体化为日月星辰、山川河流、草木万物，创造了这个世界。",
    "stories": [
      [
        "盘古"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.382+00:00",
    "updatedAt": "2025-12-24T19:53:48.382+00:00"
  },
  {
    "id": "42c158fe-d4fd-4890-b866-cf58bbf7b599",
    "name": "女娲造人",
    "category": "创世神话",
    "origin": "《风俗通义》《太平御览》",
    "period": null,
    "description": "天地初开，万物俱备，唯独没有人类。女娲行走在天地之间，感到十分孤独。她来到水边，照见自己的倒影，便用黄土和水，依照自己的模样捏出了第一个人。后来她用藤条蘸泥浆甩出无数泥点，化为芸芸众生。女娲又定下婚姻之礼，使人类得以繁衍生息。",
    "stories": [
      [
        "女娲"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.383+00:00",
    "updatedAt": "2025-12-24T19:53:48.383+00:00"
  },
  {
    "id": "ed976f40-fbd9-4355-b5aa-92e36f19b49e",
    "name": "女娲补天",
    "category": "创世神话",
    "origin": "《淮南子》《列子》",
    "period": null,
    "description": "上古时代，水神共工与火神祝融大战，共工战败后怒触不周山，天柱折断，天塌地陷，洪水泛滥。女娲不忍人类受难，于是炼五色石补天，斩神龟之足撑四极，杀黑龙以济冀州，积芦灰以止淫水，终于平息灾难，拯救人类。",
    "stories": [
      [
        "女娲",
        "共工",
        "祝融"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.383+00:00",
    "updatedAt": "2025-12-24T19:53:48.383+00:00"
  },
  {
    "id": "f9c05a29-a9ff-4d6a-899c-7527295bd96a",
    "name": "后羿射日",
    "category": "英雄神话",
    "origin": "《山海经》《淮南子》",
    "period": null,
    "description": "远古时期，天上有十个太阳同时出现，大地被烤焦，河流干涸，民不聊生。英雄后羿挺身而出，登上昆仑山顶，运足神力，拉开神弓，一气射下九个太阳，只留一个太阳照耀大地，拯救了苍生万物。",
    "stories": [
      [
        "后羿",
        "羲和",
        "帝俊",
        "嫦娥"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.384+00:00",
    "updatedAt": "2025-12-24T19:53:48.384+00:00"
  },
  {
    "id": "b3af40d0-138c-4570-80a7-4578993783a0",
    "name": "大禹治水",
    "category": "英雄神话",
    "origin": "《尚书》《史记·夏本纪》",
    "period": null,
    "description": "上古时期，洪水泛滥，百姓流离失所。大禹受命治水，他吸取父亲鲧堵塞治水失败的教训，采用疏导的方法。大禹三过家门而不入，历经十三年艰辛，终于疏通九州河道，将洪水引入大海，使天下太平。大禹因治水有功，被推举为部落联盟首领，后建立夏朝。",
    "stories": [
      [
        "大禹",
        "鲧",
        "舜"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.384+00:00",
    "updatedAt": "2025-12-24T19:53:48.384+00:00"
  },
  {
    "id": "6cb99375-3c12-4469-94a8-d01ebd76fabf",
    "name": "神农尝百草",
    "category": "英雄神话",
    "origin": "《淮南子》《搜神记》",
    "period": null,
    "description": "上古时代，人们茹毛饮血，常因误食毒物而死。神农氏为解救百姓，亲自尝遍百草，辨别药性。他一日之内曾中毒七十二次，幸得茶叶解毒。神农将所尝草药的药性一一记录，教导百姓种植五谷、辨识草药，被尊为农业和医药之祖。",
    "stories": [
      [
        "神农",
        "炎帝"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.385+00:00",
    "updatedAt": "2025-12-24T19:53:48.385+00:00"
  },
  {
    "id": "32941ca7-afe2-4e87-855d-02b90a4ed72b",
    "name": "黄帝战蚩尤",
    "category": "英雄神话",
    "origin": "《史记·五帝本纪》《山海经》",
    "period": null,
    "description": "上古时期，蚩尤率领九黎部落作乱，兴风作雾，为害人间。黄帝率领炎帝部落与之决战于涿鹿之野。蚩尤施展妖术，大雾弥漫，黄帝军队迷失方向。黄帝命人制作指南车辨别方向，又请来旱魃驱散大雾，最终擒杀蚩尤，统一华夏，被尊为人文初祖。",
    "stories": [
      [
        "黄帝",
        "蚩尤",
        "炎帝",
        "旱魃",
        "风伯",
        "雨师"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.385+00:00",
    "updatedAt": "2025-12-24T19:53:48.385+00:00"
  },
  {
    "id": "e0aab3f8-277c-4c83-8ffe-6bbe11f62e50",
    "name": "刑天舞干戚",
    "category": "英雄神话",
    "origin": "《山海经·海外西经》",
    "period": null,
    "description": "刑天是炎帝的臣子，炎帝被黄帝打败后，刑天不服，独自挑战黄帝。激战中，黄帝砍下刑天的头颅，埋于常羊山。刑天不死，以双乳为目，以肚脐为口，手持干戚继续战斗，象征着不屈不挠的战斗精神。",
    "stories": [
      [
        "刑天",
        "黄帝",
        "炎帝"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.386+00:00",
    "updatedAt": "2025-12-24T19:53:48.386+00:00"
  },
  {
    "id": "2c5f367b-2558-4ca4-a302-bf66d05e02df",
    "name": "精卫填海",
    "category": "自然神话",
    "origin": "《山海经·北山经》",
    "period": null,
    "description": "炎帝的小女儿女娃，在东海游玩时不幸溺水身亡。她的灵魂化作一只名叫精卫的小鸟，常衔西山的木石，投入东海，誓要将大海填平。精卫日复一日，年复一年，从不停歇，象征着坚韧不拔、矢志不渝的精神。",
    "stories": [
      [
        "精卫",
        "炎帝",
        "女娃"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.386+00:00",
    "updatedAt": "2025-12-24T19:53:48.386+00:00"
  },
  {
    "id": "1362778b-3c5c-4833-a41c-cf3b287801c9",
    "name": "夸父追日",
    "category": "自然神话",
    "origin": "《山海经·海外北经》《列子·汤问》",
    "period": null,
    "description": "巨人夸父立志追赶太阳，他跨过千山万水，越跑越快，离太阳越来越近。途中他喝干了黄河、渭水，仍然口渴难耐，便向北去喝大泽之水。可惜还未到达，便渴死在途中。他的手杖化作桃林，为后人遮阴解渴，象征着人类征服自然的雄心壮志。",
    "stories": [
      [
        "夸父"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.387+00:00",
    "updatedAt": "2025-12-24T19:53:48.387+00:00"
  },
  {
    "id": "41c5efeb-02a2-4513-a89e-c5115db1513d",
    "name": "愚公移山",
    "category": "自然神话",
    "origin": "《列子·汤问》",
    "period": null,
    "description": "太行、王屋二山挡住了愚公家的出路。年近九十的愚公决心移走大山，率领子孙挖山不止。智叟嘲笑他不自量力，愚公答道：子子孙孙无穷尽，山却不会增高。天帝被其诚心感动，命夸娥氏二子背走两座大山，从此道路畅通。",
    "stories": [
      [
        "愚公",
        "智叟",
        "夸娥氏"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.387+00:00",
    "updatedAt": "2025-12-24T19:53:48.387+00:00"
  },
  {
    "id": "29ec7195-7995-4905-b938-5e055dd9c883",
    "name": "共工怒触不周山",
    "category": "自然神话",
    "origin": "《淮南子·天文训》《列子》",
    "period": null,
    "description": "水神共工与火神祝融争夺帝位，大战数日，共工战败。他羞愤难当，一头撞向支撑天地的不周山。天柱折断，天倾西北，地陷东南，日月星辰向西移动，江河湖海向东流淌，从此形成了中国西高东低的地势。",
    "stories": [
      [
        "共工",
        "祝融",
        "颛顼"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.388+00:00",
    "updatedAt": "2025-12-24T19:53:48.388+00:00"
  },
  {
    "id": "d04aa3d7-a9b0-4e7a-bb0a-7e42ac49a296",
    "name": "嫦娥奔月",
    "category": "爱情神话",
    "origin": "《淮南子》《搜神记》",
    "period": null,
    "description": "后羿射日后，西王母赐予他一颗不死仙丹。后羿舍不得离开妻子嫦娥，便将仙丹交给嫦娥保管。不料此事被恶徒蓬蒙得知，趁后羿外出时逼迫嫦娥交出仙丹。嫦娥情急之下吞下仙丹，身体飘离地面，飞向月宫。从此嫦娥独居广寒宫，与玉兔为伴，后羿只能在月下遥望思念。",
    "stories": [
      [
        "嫦娥",
        "后羿",
        "蓬蒙",
        "西王母",
        "玉兔"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.388+00:00",
    "updatedAt": "2025-12-24T19:53:48.388+00:00"
  },
  {
    "id": "f1c65df7-af3b-49b3-b83b-919a7a8fec5d",
    "name": "牛郎织女",
    "category": "爱情神话",
    "origin": "《诗经》《荆楚岁时记》",
    "period": null,
    "description": "牛郎是人间孤苦的放牛郎，织女是天上王母娘娘的外孙女。二人相爱成婚，生下一双儿女。王母娘娘得知后大怒，派天兵天将捉回织女。牛郎披上老牛皮追赶，王母拔下金簪划出银河阻隔。喜鹊感其真情，每年七月七日搭成鹊桥，让二人相会一次。",
    "stories": [
      [
        "牛郎",
        "织女",
        "王母娘娘",
        "老牛"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.389+00:00",
    "updatedAt": "2025-12-24T19:53:48.389+00:00"
  },
  {
    "id": "8b0962ab-a026-485e-b370-3a3fc5478539",
    "name": "白蛇传",
    "category": "爱情神话",
    "origin": "《警世通言》民间传说",
    "period": null,
    "description": "白蛇精白素贞修炼千年化为人形，在西湖断桥与书生许仙相遇相爱，结为夫妻。金山寺法海和尚认为人妖殊途，多次阻挠。端午节白素贞误饮雄黄酒现出原形，许仙惊吓而死。白素贞盗取仙草救活许仙，最终被法海镇压于雷峰塔下。",
    "stories": [
      [
        "白素贞",
        "许仙",
        "小青",
        "法海"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.389+00:00",
    "updatedAt": "2025-12-24T19:53:48.389+00:00"
  },
  {
    "id": "64670e3a-1eaf-4873-ab5f-902189db55d1",
    "name": "梁山伯与祝英台",
    "category": "爱情神话",
    "origin": "民间传说",
    "period": null,
    "description": "祝英台女扮男装外出求学，与梁山伯同窗三年，结下深厚情谊。分别时祝英台暗示身份，梁山伯后知真相，前往祝家求婚，却得知祝英台已被许配他人。梁山伯相思成疾而亡，祝英台出嫁途中跳入梁山伯墓中，二人化为蝴蝶双飞。",
    "stories": [
      [
        "梁山伯",
        "祝英台"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.390+00:00",
    "updatedAt": "2025-12-24T19:53:48.390+00:00"
  },
  {
    "id": "86cf17e7-4209-45a2-847c-21d0cb8b8ba3",
    "name": "孟姜女哭长城",
    "category": "爱情神话",
    "origin": "民间传说",
    "period": null,
    "description": "秦始皇修筑长城，孟姜女的丈夫范喜良被征去服役。孟姜女千里寻夫送寒衣，到达长城后得知丈夫已累死，尸骨埋于城墙之下。孟姜女悲痛欲绝，在城墙下痛哭三日三夜，哭倒长城八百里，露出丈夫尸骨。",
    "stories": [
      [
        "孟姜女",
        "范喜良",
        "秦始皇"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.390+00:00",
    "updatedAt": "2025-12-24T19:53:48.390+00:00"
  },
  {
    "id": "0250f5b3-5f6a-4759-bf21-71c9d724f467",
    "name": "八仙过海",
    "category": "神仙传说",
    "origin": "《东游记》民间传说",
    "period": null,
    "description": "八位神仙赴王母娘娘蟠桃盛会归来，途经东海。吕洞宾提议各显神通渡海，不得乘云驾雾。于是铁拐李投葫芦、汉钟离扔芭蕉扇、张果老倒骑毛驴、蓝采和抛花篮、何仙姑坐荷花、吕洞宾踏宝剑、韩湘子吹玉笛、曹国舅持玉板，各凭本事渡过东海。",
    "stories": [
      [
        "铁拐李",
        "汉钟离",
        "张果老",
        "蓝采和",
        "何仙姑",
        "吕洞宾",
        "韩湘子",
        "曹国舅"
      ]
    ],
    "symbolism": null,
    "createdAt": "2025-12-24T19:53:48.390+00:00",
    "updatedAt": "2025-12-24T19:53:48.390+00:00"
