        "name": "北伐曹魏",
        "year": 228,
        "role": "主帅",
        "description": "六出祁山，北伐曹魏"
      }
    ],
    "evaluations": [
      {
        "source": "《三国志》",
        "content": "诸葛亮之为相国也，抚百姓，示仪轨，约官职，从权制，开诚心，布公道。",
        "author": "陈寿"
      }
    ],
